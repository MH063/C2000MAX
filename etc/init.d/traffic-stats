#!/bin/sh /etc/rc.common
# 流量统计初始化脚本
# 用于 OpenWrt 路由器启动时恢复 ipset 和 iptables 规则

START=95
STOP=15

IPSET_RX="traffic_stats_rx"
IPSET_TX="traffic_stats_tx"
CHAIN_RX="TRAFFIC_STATS_RX"
CHAIN_TX="TRAFFIC_STATS_TX"
DATA_DIR="/tmp/traffic_stats"
STATS_FILE="${DATA_DIR}/device_stats.json"
BLOCKLIST_FILE=""

clear_blocklist_rules() {
    echo "traffic-stats: Clearing blocklist iptables rules..."
    
    local mac_list=$(iptables -L INPUT -n 2>/dev/null | grep -oE "MAC[a-fA-F0-9:]+" | sed 's/MAC//' | sort -u)
    
    echo "traffic-stats: Found MAC list from iptables: ${mac_list}"
    
    for mac in ${mac_list}; do
        if [ -n "${mac}" ]; then
            local lower_mac=$(echo "${mac}" | tr '[:upper:]' '[:lower:]')
            echo "traffic-stats: Removing iptables rule for MAC: ${mac}"
            iptables -D INPUT -m mac --mac-source ${lower_mac} -j DROP 2>/dev/null
            iptables -D FORWARD -m mac --mac-source ${lower_mac} -j DROP 2>/dev/null
        fi
    done

    echo "traffic-stats: Clearing access_ctl blacklist..."

    find_blocklist_file
    if [ -f "${BLOCKLIST_FILE}" ]; then
        local blocked_macs=$(grep -oE '"mac"[[:space:]]*:[[:space:]]*"[0-9A-Fa-f:]+"' "${BLOCKLIST_FILE}" 2>/dev/null | sed 's/.*"mac"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
        
        for mac in ${blocked_macs}; do
            if [ -n "${mac}" ]; then
                local lower_mac=$(echo "${mac}" | tr '[:upper:]' '[:lower:]')
                echo "traffic-stats: Removing access_ctl block for MAC: ${mac}"
                access_ctl.sh -m ${lower_mac} -a 1 2>/dev/null
            fi
        done

        echo "traffic-stats: Access_ctl blacklist cleared"
    else
        echo "traffic-stats: No blocklist file found, skipping access_ctl cleanup"
    fi

    echo "traffic-stats: All blocklist rules cleared"
}

find_blocklist_file() {
    local search_paths="/mnt/mmcblk0p1 /mnt/sdcard /tmp/mnt/mmcblk0p1 /overlay /tmp"
    for base_path in ${search_paths}; do
        local file_path="${base_path}/router_assistant/mac_blocklist.json"
        if [ -f "${file_path}" ]; then
            BLOCKLIST_FILE="${file_path}"
            echo "traffic-stats: Found blocklist file: ${BLOCKLIST_FILE}"
            return 0
        fi
    done
    echo "traffic-stats: No blocklist file found"
    return 1
}

restore_blocklist() {
    if ! find_blocklist_file; then
        return 0
    fi

    if [ ! -f "${BLOCKLIST_FILE}" ]; then
        echo "traffic-stats: Blocklist file not found"
        return 1
    fi

    local count=0
    local mac_list=$(grep -oE '"mac"[[:space:]]*:[[:space:]]*"[0-9A-Fa-f:]+"' "${BLOCKLIST_FILE}" 2>/dev/null | sed 's/.*"mac"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
    
    for mac in ${mac_list}; do
        if [ -n "${mac}" ]; then
            local lower_mac=$(echo "${mac}" | tr '[:upper:]' '[:lower:]')
            iptables -I INPUT -m mac --mac-source ${lower_mac} -j DROP 2>/dev/null
            iptables -I FORWARD -m mac --mac-source ${lower_mac} -j DROP 2>/dev/null
            count=$((count + 1))
            echo "traffic-stats: Restored block rule for MAC: ${mac}"
        fi
    done

    echo "traffic-stats: Restored ${count} blocked devices from blocklist"
}

check_ipset() {
    command -v ipset >/dev/null 2>&1
}

init_ipset() {
    echo "traffic-stats: Initializing ipset..."

    ipset create ${IPSET_RX} hash:mac counters 2>/dev/null
    ipset create ${IPSET_TX} hash:mac counters 2>/dev/null

    local existing_rx=$(ipset list ${IPSET_RX} 2>/dev/null | grep -c "^[0-9a-fA-F][0-9a-fA-F]:")
    local existing_tx=$(ipset list ${IPSET_TX} 2>/dev/null | grep -c "^[0-9a-fA-F][0-9a-fA-F]:")

    echo "traffic-stats: ipset ${IPSET_RX}: ${existing_rx} entries, ${IPSET_TX}: ${existing_tx} entries"
}

init_iptables() {
    echo "traffic-stats: Initializing iptables rules..."

    iptables -t mangle -N ${CHAIN_RX} 2>/dev/null
    iptables -t mangle -F ${CHAIN_RX}
    iptables -t mangle -A ${CHAIN_RX} -j RETURN
    iptables -t mangle -D FORWARD -j ${CHAIN_RX} 2>/dev/null
    iptables -t mangle -I FORWARD -j ${CHAIN_RX}

    iptables -t mangle -N ${CHAIN_TX} 2>/dev/null
    iptables -t mangle -F ${CHAIN_TX}
    iptables -t mangle -A ${CHAIN_TX} -j RETURN
    iptables -t mangle -D FORWARD -j ${CHAIN_TX} 2>/dev/null
    iptables -t mangle -I FORWARD -j ${CHAIN_TX}

    echo "traffic-stats: iptables rules initialized"
}

restore_devices() {
    local lease_file="/tmp/dhcp.leases"
    local count=0

    if [ -f "${lease_file}" ]; then
        while read -r line; do
            mac=$(echo "${line}" | awk '{print $2}' | tr '[:lower:]' '[:upper:]')
            if [ -n "${mac}" ] && [ "${mac}" != "MAC" ] && [ "${mac}" != "00:00:00:00:00:00" ]; then
                ipset -q add ${IPSET_RX} ${mac}
                ipset -q add ${IPSET_TX} ${mac}
                count=$((count + 1))
            fi
        done < "${lease_file}"
    fi

    echo "traffic-stats: Restored ${count} devices from dhcp.leases"
}

restore_from_stats() {
    if [ ! -f "${STATS_FILE}" ]; then
        echo "traffic-stats: No stats file found, skipping restore"
        return
    fi

    local count=0
    local macs=$(grep -oE '([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}' "${STATS_FILE}" 2>/dev/null | sort -u)
    for mac in ${macs}; do
        local upper_mac=$(echo "${mac}" | tr '[:lower:]' '[:upper:]')
        ipset -q add ${IPSET_RX} ${upper_mac}
        ipset -q add ${IPSET_TX} ${upper_mac}
        count=$((count + 1))
    done

    echo "traffic-stats: Restored ${count} devices from previous stats"
}

start() {
    if ! check_ipset; then
        echo "traffic-stats: ipset not found, skipping..."
        return 1
    fi

    echo "traffic-stats: Starting traffic statistics service..."

    init_ipset
    init_iptables
    restore_devices
    restore_from_stats

    echo "traffic-stats: Restoring MAC blocklist..."
    restore_blocklist

    echo "traffic-stats: Traffic statistics service started"
}

stop() {
    echo "traffic-stats: Stopping traffic statistics service..."

    iptables -t mangle -D FORWARD -j ${CHAIN_RX} 2>/dev/null
    iptables -t mangle -D FORWARD -j ${CHAIN_TX} 2>/dev/null
    iptables -t mangle -F ${CHAIN_RX} 2>/dev/null
    iptables -t mangle -F ${CHAIN_TX} 2>/dev/null
    iptables -t mangle -X ${CHAIN_RX} 2>/dev/null
    iptables -t mangle -X ${CHAIN_TX} 2>/dev/null

    echo "traffic-stats: Calling clear_blocklist_rules..."
    clear_blocklist_rules
    echo "traffic-stats: clear_blocklist_rules returned"

    echo "traffic-stats: Traffic statistics service stopped"
}

reload() {
    restore_devices
    restore_from_stats
}

status() {
    echo "=== Traffic Stats Status ==="
    echo ""
    echo "ipset ${IPSET_RX} entries:"
    ipset list ${IPSET_RX} 2>/dev/null | head -20
    echo ""
    echo "ipset ${IPSET_TX} entries:"
    ipset list ${IPSET_TX} 2>/dev/null | head -20
    echo ""
    echo "iptables mangle rules:"
    iptables -t mangle -L ${CHAIN_RX} -n 2>/dev/null
    iptables -t mangle -L ${CHAIN_TX} -n 2>/dev/null
}
