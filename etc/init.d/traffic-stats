#!/bin/sh /etc/rc.common
# 流量统计初始化脚本
# 用于 OpenWrt 路由器启动时恢复 ipset 和 iptables 规则

START=95
STOP=15

IPSET_RX="traffic_stats_rx"
IPSET_TX="traffic_stats_tx"
IPSET_RX_IP="traffic_stats_rx_ip"
IPSET_RX_IP6="traffic_stats_rx_ip6"
CHAIN_RX="TRAFFIC_STATS_RX"
CHAIN_TX="TRAFFIC_STATS_TX"
CHAIN_RX_IP="TRAFFIC_STATS_RX_IP"
DATA_DIR_NAME="router_assistant"

# 存储路径搜索顺序（与 router_assistant.lua 保持一致）
STORAGE_BASE_PATHS="/tmp/storage/mmcblk0p1 /mnt/mmcblk0p1 /mnt/sdcard /tmp/mnt/mmcblk0p1 /overlay"

# 动态获取数据目录（与 router_assistant.lua 逻辑一致）
get_data_dir() {
    for base_path in ${STORAGE_BASE_PATHS}; do
        local data_dir="${base_path}/${DATA_DIR_NAME}"
        if [ -d "${data_dir}" ] && [ -w "${data_dir}" ]; then
            echo "${data_dir}"
            return 0
        fi
    done
    # 回退到内存目录
    echo "/tmp/${DATA_DIR_NAME}"
    return 0
}

DATA_DIR=$(get_data_dir)
STATS_FILE="${DATA_DIR}/current.json"
BLOCKLIST_FILE=""

# 黑名单文件搜索路径（与 router_assistant.lua 和 postinst 保持一致）
BLOCKLIST_SEARCH_PATHS="/tmp/storage/mmcblk0p1 /mnt/mmcblk0p1 /mnt/sdcard /tmp/mnt/mmcblk0p1 /overlay /tmp"

# 查找黑名单文件
find_blocklist_file() {
    local base_path
    for base_path in ${BLOCKLIST_SEARCH_PATHS}; do
        local file_path="${base_path}/router_assistant/mac_blocklist.json"
        if [ -f "${file_path}" ]; then
            BLOCKLIST_FILE="${file_path}"
            echo "traffic-stats: 找到黑名单文件: ${BLOCKLIST_FILE}"
            return 0
        fi
    done
    BLOCKLIST_FILE=""
    echo "traffic-stats: 未找到黑名单文件"
    return 1
}

# 从 iptables 中提取被屏蔽的 MAC 地址列表
extract_blocked_macs_from_iptables() {
    local chain="${1:-INPUT}"
    iptables -L "${chain}" -n 2>/dev/null | grep -oE "MAC[a-fA-F0-9:]+" | sed 's/MAC//' | sort -u
}

# 清除所有屏蔽规则（设备卸载或服务停止时调用）
clear_blocklist_rules() {
    echo "traffic-stats: 正在清除屏蔽规则..."

    # 方法1：从 iptables INPUT/FORWARD 链中提取并删除 DROP 规则
    local mac_list=$(extract_blocked_macs_from_iptables "INPUT")
    mac_list="${mac_list} $(extract_blocked_macs_from_iptables "FORWARD")"
    mac_list="${mac_list} $(extract_blocked_macs_from_iptables "internet_access" 2>/dev/null)"

    if [ -z "${mac_list}" ]; then
        echo "traffic-stats: 未发现屏蔽规则"
    else
        local seen_macs=""
        for mac in ${mac_list}; do
            if [ -n "${mac}" ]; then
                # 去重处理
                case " ${seen_macs} " in
                    *" ${mac} "*) continue ;;
                esac
                seen_macs="${seen_macs} ${mac}"

                local lower_mac=$(echo "${mac}" | tr '[:upper:]' '[:lower:]')
                echo "traffic-stats: 删除屏蔽规则 MAC: ${mac}"
                iptables -D INPUT -m mac --mac-source "${lower_mac}" -j DROP 2>/dev/null
                iptables -D FORWARD -m mac --mac-source "${lower_mac}" -j DROP 2>/dev/null
            fi
        done
    fi

    # 方法2：从黑名单文件中恢复 ACL 访问权限
    find_blocklist_file
    if [ -n "${BLOCKLIST_FILE}" ] && [ -f "${BLOCKLIST_FILE}" ]; then
        local blocked_macs=$(grep -oE '"mac"[[:space:]]*:[[:space:]]*"[0-9A-Fa-f:]+"' "${BLOCKLIST_FILE}" 2>/dev/null | sed 's/.*"mac"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')

        for mac in ${blocked_macs}; do
            if [ -n "${mac}" ]; then
                local lower_mac=$(echo "${mac}" | tr '[:upper:]' '[:lower:]')
                echo "traffic-stats: 恢复 ACL 访问权限 MAC: ${mac}"
                access_ctl.sh -m "${lower_mac}" -a 1 2>/dev/null
            fi
        done
    fi

    echo "traffic-stats: 所有屏蔽规则已清除"
}

# 从黑名单文件恢复屏蔽规则（路由器启动时调用）
restore_blocklist() {
    if ! find_blocklist_file; then
        echo "traffic-stats: 无黑名单文件，跳过恢复"
        return 0
    fi
    if [ ! -f "${BLOCKLIST_FILE}" ]; then
        echo "traffic-stats: 黑名单文件不存在"
        return 1
    fi
    local count=0
    local mac_list=$(grep -oE '"mac"[[:space:]]*:[[:space:]]*"[0-9A-Fa-f:]+"' "${BLOCKLIST_FILE}" 2>/dev/null | sed 's/.*"mac"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')

    for mac in ${mac_list}; do
        if [ -n "${mac}" ] && [ "${mac}" != "00:00:00:00:00:00" ] && [ "${mac}" != "FF:FF:FF:FF:FF:FF" ]; then
            local lower_mac=$(echo "${mac}" | tr '[:upper:]' '[:lower:]')
            # 添加 iptables 规则（忽略重复错误）
            iptables -I INPUT -m mac --mac-source "${lower_mac}" -j DROP 2>/dev/null
            iptables -I FORWARD -m mac --mac-source "${lower_mac}" -j DROP 2>/dev/null
            count=$((count + 1))
            echo "traffic-stats: 已恢复屏蔽规则 MAC: ${mac}"
        fi
    done
    echo "traffic-stats: 共恢复 ${count} 条屏蔽规则"
}

check_ipset() {
    command -v ipset >/dev/null 2>&1
}

init_ipset() {
    echo "traffic-stats: 正在初始化 ipset..."

    local IPSET_MAXELEM=4096
    ipset create ${IPSET_RX} hash:mac counters maxelem ${IPSET_MAXELEM} 2>/dev/null
    ipset create ${IPSET_TX} hash:mac counters maxelem ${IPSET_MAXELEM} 2>/dev/null
    # 创建按 IP 统计 RX 流量的 ipset（用于准确统计下行流量）
    ipset create ${IPSET_RX_IP} hash:ip counters maxelem ${IPSET_MAXELEM} family inet 2>/dev/null
    # IPv6 RX 流量统计
    ipset create ${IPSET_RX_IP6} hash:ip counters maxelem ${IPSET_MAXELEM} family inet6 2>/dev/null
    local existing_rx=$(ipset list ${IPSET_RX} 2>/dev/null | grep -c "^[0-9a-fA-F][0-9a-fA-F]:")
    local existing_tx=$(ipset list ${IPSET_TX} 2>/dev/null | grep -c "^[0-9a-fA-F][0-9a-fA-F]:")
    local existing_rx_ip=$(ipset list ${IPSET_RX_IP} 2>/dev/null | grep -c "^[0-9]")
    local existing_rx_ip6=$(ipset list ${IPSET_RX_IP6} 2>/dev/null | grep -c "^[0-9a-fA-F]")

    echo "traffic-stats: ipset ${IPSET_RX}: ${existing_rx}, ${IPSET_TX}: ${existing_tx}, ${IPSET_RX_IP}: ${existing_rx_ip}, ${IPSET_RX_IP6}: ${existing_rx_ip6}"
}

init_iptables() {
    echo "traffic-stats: 正在初始化 iptables 规则..."

    iptables -t mangle -N ${CHAIN_RX} 2>/dev/null
    iptables -t mangle -F ${CHAIN_RX}
    iptables -t mangle -N ${CHAIN_TX} 2>/dev/null
    iptables -t mangle -F ${CHAIN_TX}
    # 创建按 IP 统计 RX 流量的链
    iptables -t mangle -N ${CHAIN_RX_IP} 2>/dev/null
    iptables -t mangle -F ${CHAIN_RX_IP}

    # 挂载到 FORWARD 链（确保在链首部）
    iptables -t mangle -D FORWARD -j ${CHAIN_RX} 2>/dev/null
    iptables -t mangle -I FORWARD -j ${CHAIN_RX}
    iptables -t mangle -D FORWARD -j ${CHAIN_TX} 2>/dev/null
    iptables -t mangle -I FORWARD -j ${CHAIN_TX}

    # === TX 上行规则：LAN设备→互联网 的流量，按源MAC匹配ipset计数器累加 ===
    # 匹配从局域网接口进入转发的数据包，用源MAC查ipset，命中则自动累加该MAC的计数器
    for iface in $(ls /sys/class/net/ 2>/dev/null | grep -E '^(br-lan|eth[0-9]|ra0|rai0|wlan0|wlan1|wwan0)' ); do
        [ -d "/sys/class/net/${iface}" ] || continue
        # -i 入接口：从LAN进来的包，src-mac就是发送方设备MAC
        iptables -t mangle -A ${CHAIN_TX} -i "${iface}" \
            -m set --match-set ${IPSET_TX} src -j RETURN 2>/dev/null && \
            echo "traffic-stats: TX规则已添加: -i ${iface}"
    done

    # === RX 下行规则：按目的 IP 统计（最可靠的方式）===
    # 在 POSTROUTING 链中，数据包的目的 IP 是最终设备的 IP
    # 挂载到 POSTROUTING 链
    iptables -t mangle -D POSTROUTING -j ${CHAIN_RX_IP} 2>/dev/null
    iptables -t mangle -I POSTROUTING -j ${CHAIN_RX_IP}
    # 匹配发往 br-lan 的 IPv4 数据包，按目的 IP 统计
    iptables -t mangle -A ${CHAIN_RX_IP} -o br-lan \
        -m set --match-set ${IPSET_RX_IP} dst -j RETURN 2>/dev/null && \
        echo "traffic-stats: RX_IP规则已添加: -o br-lan (IPv4)"

    # === IPv6 RX 下行规则 ===
    if command -v ip6tables >/dev/null 2>&1; then
        # 先创建 ip6tables 的链（与 iptables 分离）
        ip6tables -t mangle -N ${CHAIN_RX_IP} 2>/dev/null
        ip6tables -t mangle -F ${CHAIN_RX_IP}
        ip6tables -t mangle -D POSTROUTING -j ${CHAIN_RX_IP} 2>/dev/null
        ip6tables -t mangle -I POSTROUTING -j ${CHAIN_RX_IP}
        ip6tables -t mangle -A ${CHAIN_RX_IP} -o br-lan \
            -m set --match-set ${IPSET_RX_IP6} dst -j RETURN 2>/dev/null && \
            echo "traffic-stats: RX_IP规则已添加: -o br-lan (IPv6)"
        # IPv6 兜底规则
        ip6tables -t mangle -A ${CHAIN_RX_IP} -j RETURN
    fi

    # 保留 ebtables 作为备用（用于网桥内部流量）
    if command -v ebtables >/dev/null 2>&1 && [ -d /sys/class/net/br-lan ]; then
        echo "traffic-stats: 初始化 ebtables 备用规则..."
        ebtables -t filter -F TRAFFIC_STATS_RX 2>/dev/null
        ebtables -t filter -X TRAFFIC_STATS_RX 2>/dev/null
        ebtables -t filter -N TRAFFIC_STATS_RX 2>/dev/null || true
        ebtables -t filter -F TRAFFIC_STATS_RX 2>/dev/null
        ebtables -t filter -D FORWARD -j TRAFFIC_STATS_RX 2>/dev/null
        ebtables -t filter -I FORWARD -j TRAFFIC_STATS_RX
        echo "traffic-stats: ebtables 备用规则已初始化"
    fi

    # 兜底：未命中的包直接放行
    iptables -t mangle -A ${CHAIN_RX} -j RETURN
    iptables -t mangle -A ${CHAIN_TX} -j RETURN
    iptables -t mangle -A ${CHAIN_RX_IP} -j RETURN

    echo "traffic-stats: iptables 规则初始化完成"
}

restore_devices() {
    local lease_file="/tmp/dhcp.leases"
    local count=0
    local count_ip=0
    local count_ip6=0

    if [ -f "${lease_file}" ]; then
        while read -r line; do
            mac=$(echo "${line}" | awk '{print $2}' | tr '[:lower:]' '[:upper:]')
            ip=$(echo "${line}" | awk '{print $3}')
            if [ -n "${mac}" ] && [ "${mac}" != "MAC" ] && [ "${mac}" != "00:00:00:00:00:00" ]; then
                ipset -q add ${IPSET_RX} ${mac}
                ipset -q add ${IPSET_TX} ${mac}
                # 添加 IPv4 到 RX_IP ipset（用于按 IP 统计下行流量）
                if [ -n "${ip}" ] && [ "${ip}" != "0.0.0.0" ]; then
                    ipset -q add ${IPSET_RX_IP} ${ip}
                    count_ip=$((count_ip + 1))
                fi
                # 添加 IPv6 地址到 RX_IP6 ipset（从邻居表获取）
                if command -v ip >/dev/null 2>&1; then
                    for ipv6_addr in $(ip -6 neigh show 2>/dev/null | grep -i "${mac}" | awk '{print $1}' | head -3); do
                        if [ -n "${ipv6_addr}" ] && [ "${ipv6_addr}" != "fe80"::* ]; then
                            ipset -q add ${IPSET_RX_IP6} ${ipv6_addr}
                            count_ip6=$((count_ip6 + 1))
                        fi
                    done
                fi
                # 同时为 ebtables 添加 RX 规则（备用）
                if command -v ebtables >/dev/null 2>&1; then
                    ebtables -t filter -C TRAFFIC_STATS_RX -d "${mac}" -j CONTINUE 2>/dev/null || \
                    ebtables -t filter -A TRAFFIC_STATS_RX -d "${mac}" -j CONTINUE 2>/dev/null
                fi
                count=$((count + 1))
            fi
        done < "${lease_file}"
    fi
    echo "traffic-stats: 从 dhcp.leases 恢复了 ${count} 个设备 (MAC), ${count_ip} 个 IPv4, ${count_ip6} 个 IPv6"
}

restore_from_stats() {
    if [ ! -f "${STATS_FILE}" ]; then
        echo "traffic-stats: 未找到统计文件，跳过恢复"
        return
    fi
    local count=0
    local macs=$(grep -oE '([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}' "${STATS_FILE}" 2>/dev/null | sort -u)
    for mac in ${macs}; do
        local upper_mac=$(echo "${mac}" | tr '[:lower:]' '[:upper:]')
        ipset -q add ${IPSET_RX} ${upper_mac}
        ipset -q add ${IPSET_TX} ${upper_mac}
        # 同时为 ebtables 添加 RX 规则（用于准确统计下行流量）
        if command -v ebtables >/dev/null 2>&1; then
            ebtables -t filter -C TRAFFIC_STATS_RX -d "${upper_mac}" -j CONTINUE 2>/dev/null || \
            ebtables -t filter -A TRAFFIC_STATS_RX -d "${upper_mac}" -j CONTINUE 2>/dev/null
        fi
        count=$((count + 1))
    done
    echo "traffic-stats: 从历史统计恢复了 ${count} 个设备"
}

setup_cron() {
    # 添加月度快照定时任务：每月1日 00:05 自动创建月度流量快照基准
    # 这解决了"基准漂移"问题：月初首个访问前产生的流量也能被正确统计
    local CRON_FILE="/etc/crontabs/root"
    if [ -f "${CRON_FILE}" ]; then
        # 检查是否已存在月度快照任务
        if ! grep -q "monthly_snapshot" "${CRON_FILE}" 2>/dev/null; then
            echo '5 0 1 * * /usr/bin/wget -qO- "http://127.0.0.1/cgi-bin/luci/admin/status/router_assistant/create_monthly_snapshot" --post-data="" > /dev/null 2>&1 || /bin/true # monthly_snapshot' >> "${CRON_FILE}"
            /etc/init.d/cron restart 2>/dev/null
            echo "traffic-stats: 月度快照 cron 任务已添加 (每月1日 00:05)"
        else
            echo "traffic-stats: 月度快照 cron 任务已存在"
        fi
    fi
    return 0
}

remove_cron() {
    local cron_file="/etc/crontabs/root"
    if [ -f "${cron_file}" ]; then
        sed -i '/collect_traffic/d' "${cron_file}" 2>/dev/null
        /etc/init.d/cron restart 2>/dev/null
        echo "traffic-stats: Cron 任务已移除"
    fi
}

start() {
    echo "traffic-stats: 正在启动路由助手守护服务..."

    # 始终恢复 MAC 黑名单（不依赖 ipset）
    echo "traffic-stats: 正在恢复 MAC 黑名单..."
    restore_blocklist

    # ipset 流量统计功能（可选，需要 ipset 支持）
    # 注意：collect.lua 已废弃，流量统计完全依赖 router_assistant.lua 的 ubus 采集
    if check_ipset; then
        echo "traffic-stats: ipset 可用，启动流量统计功能..."
        init_ipset
        init_iptables
        restore_devices
        restore_from_stats
        setup_cron
        echo "traffic-stats: 流量统计功能已启动"
    else
        echo "traffic-stats: ipset 未安装，跳过流量统计功能（黑名单功能正常）"
    fi

    echo "traffic-stats: 服务已启动"
}

stop() {
    echo "traffic-stats: 正在停止流量统计服务..."

    # 移除 cron 任务
    remove_cron

    # 清除 iptables mangle 规则（如果存在）
    iptables -t mangle -D FORWARD -j ${CHAIN_RX} 2>/dev/null
    iptables -t mangle -D FORWARD -j ${CHAIN_TX} 2>/dev/null
    iptables -t mangle -D POSTROUTING -j ${CHAIN_RX_IP} 2>/dev/null
    iptables -t mangle -F ${CHAIN_RX} 2>/dev/null
    iptables -t mangle -F ${CHAIN_TX} 2>/dev/null
    iptables -t mangle -F ${CHAIN_RX_IP} 2>/dev/null
    iptables -t mangle -X ${CHAIN_RX} 2>/dev/null
    iptables -t mangle -X ${CHAIN_TX} 2>/dev/null
    iptables -t mangle -X ${CHAIN_RX_IP} 2>/dev/null

    # 清除 ip6tables mangle 规则（如果存在）
    ip6tables -t mangle -D POSTROUTING -j ${CHAIN_RX_IP} 2>/dev/null
    ip6tables -t mangle -F ${CHAIN_RX_IP} 2>/dev/null
    ip6tables -t mangle -X ${CHAIN_RX_IP} 2>/dev/null

    # 销毁 ipset（如果存在）
    ipset destroy ${IPSET_RX_IP} 2>/dev/null
    ipset destroy ${IPSET_RX_IP6} 2>/dev/null

    # 始终清除黑名单规则
    echo "traffic-stats: 正在调用 clear_blocklist_rules..."
    clear_blocklist_rules

    # 清理DNS加密依赖包（卸载时总是执行，不检测文件是否存在）
    echo "traffic-stats: 正在清理DNS加密依赖包..."
    
    # 停止DNS加密服务
    /etc/init.d/stubby stop 2>/dev/null
    /etc/init.d/stubby disable 2>/dev/null
    /etc/init.d/https-dns-proxy stop 2>/dev/null
    /etc/init.d/https-dns-proxy disable 2>/dev/null
    
    # 强制杀死残留进程
    sleep 1
    killall stubby 2>/dev/null
    killall https-dns-proxy 2>/dev/null
    sleep 1
    if pidof stubby >/dev/null 2>&1; then
        kill -9 $(pidof stubby) 2>/dev/null
    fi
    if pidof https-dns-proxy >/dev/null 2>&1; then
        kill -9 $(pidof https-dns-proxy) 2>/dev/null
    fi
    
    # 删除DNS加密依赖包文件
    rm -f /usr/sbin/stubby 2>/dev/null
    rm -f /usr/bin/stubby 2>/dev/null
    rm -f /etc/init.d/stubby 2>/dev/null
    rm -f /etc/config/stubby 2>/dev/null
    rm -rf /etc/stubby 2>/dev/null
    rm -f /usr/lib/opkg/info/stubby.* 2>/dev/null
    rm -f /var/run/stubby.pid 2>/dev/null
    
    rm -f /usr/sbin/https-dns-proxy 2>/dev/null
    rm -f /usr/bin/https-dns-proxy 2>/dev/null
    rm -f /etc/init.d/https-dns-proxy 2>/dev/null
    rm -f /etc/config/https-dns-proxy 2>/dev/null
    rm -f /usr/lib/opkg/info/https-dns-proxy.* 2>/dev/null
    rm -f /var/run/https-dns-proxy.pid 2>/dev/null
    
    rm -f /usr/lib/libgetdns.so* 2>/dev/null
    rm -f /usr/lib/opkg/info/getdns.* 2>/dev/null
    rm -f /usr/lib/libcares.so* 2>/dev/null
    rm -f /usr/lib/opkg/info/libcares.* 2>/dev/null
    rm -f /usr/lib/libev.so* 2>/dev/null
    rm -f /usr/lib/opkg/info/libev.* 2>/dev/null
    
    # 恢复DNS配置
    if [ -f "/etc/config/dhcp" ]; then
        uci -q delete dhcp.@dnsmasq[0].noresolv 2>/dev/null
        uci -q delete dhcp.@dnsmasq[0].localuse 2>/dev/null
        server_idx=0
        while uci -q get dhcp.@dnsmasq[0].server >/dev/null 2>&1; do
            srv=$(uci -q get dhcp.@dnsmasq[0].server)
            if [ -n "$srv" ]; then
                uci -q delete dhcp.@dnsmasq[0].server
            else
                break
            fi
            server_idx=$((server_idx + 1))
            if [ $server_idx -gt 10 ]; then
                break
            fi
        done
        uci -q set dhcp.@dnsmasq[0].resolvfile='/tmp/resolv.conf.d/resolv.conf.auto'
        uci commit dhcp
        /etc/init.d/dnsmasq restart 2>/dev/null
    fi
    
    # 清理防火墙钩子
    rm -f /etc/hotplug.d/firewall/99-traffic-stats 2>/dev/null
    rm -f /etc/hotplug.d/firewall/98-rate-limit-restore 2>/dev/null
    sed -i '/traffic-stats restart/d' /etc/firewall.user 2>/dev/null
    
    echo "traffic-stats: DNS加密依赖包已清理"

    echo "traffic-stats: 服务已停止"
}

reload() {
    if check_ipset; then
        # 重新初始化 iptables 规则（新增设备或接口变化后需要重建规则）
        init_iptables
        restore_devices
        restore_from_stats
    fi
    restore_blocklist
}

status() {
    echo "=== 流量统计服务状态 ==="
    echo ""

    if check_ipset; then
        echo "ipset ${IPSET_RX} 记录:"
        ipset list ${IPSET_RX} 2>/dev/null | head -20
        echo ""
        echo "ipset ${IPSET_TX} 记录:"
        ipset list ${IPSET_TX} 2>/dev/null | head -20
        echo ""
        echo "ipset ${IPSET_RX_IP} 记录 (IPv4):"
        ipset list ${IPSET_RX_IP} 2>/dev/null | head -20
        echo ""
        echo "ipset ${IPSET_RX_IP6} 记录 (IPv6):"
        ipset list ${IPSET_RX_IP6} 2>/dev/null | head -20
        echo ""
        echo "iptables mangle 规则:"
        iptables -t mangle -L ${CHAIN_RX} -n 2>/dev/null
        iptables -t mangle -L ${CHAIN_TX} -n 2>/dev/null
        iptables -t mangle -L ${CHAIN_RX_IP} -n 2>/dev/null
        echo ""
        echo "ip6tables mangle 规则:"
        ip6tables -t mangle -L ${CHAIN_RX_IP} -n 2>/dev/null
    else
        echo "ipset 未安装，流量统计功能未启用"
    fi

    echo ""
    echo "当前 iptables 屏蔽规则:"
    echo "--- INPUT 链 ---"
    iptables -L INPUT -n 2>/dev/null | grep -i "MAC\|mac-source" || echo "(无)"
    echo ""
    echo "--- FORWARD 链 ---"
    iptables -L FORWARD -n 2>/dev/null | grep -i "MAC\|mac-source" || echo "(无)"
    echo ""
    echo "黑名单文件位置:"
    find_blocklist_file
}

# 清理所有流量统计数据（保留黑名单配置）
# 用法: /etc/init.d/traffic-stats purge_data
purge_data() {
    echo "traffic-stats: 正在清理所有流量统计数据（保留黑名单）..."

    # 1. 备份黑名单
    BLOCKLIST_BACKUP=""
    if [ -n "${BLOCKLIST_FILE}" ] && [ -f "${BLOCKLIST_FILE}" ]; then
        BLOCKLIST_BACKUP="/tmp/router_assistant_blocklist_backup.json"
        cp "${BLOCKLIST_FILE}" "${BLOCKLIST_BACKUP}" 2>/dev/null
        echo "traffic-stats: 已备份黑名单到 ${BLOCKLIST_BACKUP}"
    else
        find_blocklist_file
        if [ -n "${BLOCKLIST_FILE}" ] && [ -f "${BLOCKLIST_FILE}" ]; then
            BLOCKLIST_BACKUP="/tmp/router_assistant_blocklist_backup.json"
            cp "${BLOCKLIST_FILE}" "${BLOCKLIST_BACKUP}" 2>/dev/null
            echo "traffic-stats: 已备份黑名单到 ${BLOCKLIST_BACKUP}"
        fi
    fi

    # 2. 清理数据目录中的流量统计文件
    # baseline.json 也会被删除，下次采集时会重新初始化（从当时的 WAN 接口字节数开始计算增量）
    # 路由器重启后如果 baseline 尚未重建，router_assistant.lua 会自动重建
    local data_dirs="${DATA_DIR} /tmp/router_assistant"
    for dir in ${data_dirs}; do
        if [ -d "${dir}" ]; then
            rm -f "${dir}/current.json" 2>/dev/null
            rm -f "${dir}/traffic_monthly.json" 2>/dev/null
            rm -f "${dir}/hourly_snapshot.json" 2>/dev/null
            rm -f "${dir}/baseline.json" 2>/dev/null
            rm -rf "${dir}/daily" 2>/dev/null
            rm -rf "${dir}/weekly" 2>/dev/null
            rm -rf "${dir}/monthly" 2>/dev/null
            rm -rf "${dir}/backup" 2>/dev/null
            echo "traffic-stats: 已清理 ${dir} 流量数据"
        fi
    done

    # 3. 清理 ipset 条目并重启服务以恢复设备列表
    # 警告：先 stop，避免 restart 时仍有进程持有 ipset 引用
    # 修复问题#5：增加等待时间到3秒，确保规则清理完成后再start，避免出现规则真空期
    if check_ipset; then
        stop
        sleep 3
        ipset flush ${IPSET_RX} 2>/dev/null
        ipset flush ${IPSET_TX} 2>/dev/null
        echo "traffic-stats: ipset 已清空"
    else
        stop
        sleep 1
    fi
    start
    echo "traffic-stats: 服务已重启，设备列表已从 dhcp.leases 恢复"

    # 4. 恢复黑名单
    if [ -n "${BLOCKLIST_BACKUP}" ] && [ -f "${BLOCKLIST_BACKUP}" ]; then
        # 确保数据目录存在
        for base_path in ${STORAGE_BASE_PATHS}; do
            if [ -d "${base_path}" ] && [ -w "${base_path}" ]; then
                mkdir -p "${base_path}/${DATA_DIR_NAME}"
                cp "${BLOCKLIST_BACKUP}" "${base_path}/${DATA_DIR_NAME}/mac_blocklist.json" 2>/dev/null
                echo "traffic-stats: 黑名单已恢复到 ${base_path}/${DATA_DIR_NAME}/mac_blocklist.json"
                # 修复问题#2：cp覆盖黑名单文件后需要再次恢复规则
                # 因为start()中的restore_blocklist()读取的是旧文件
                if find_blocklist_file && [ -f "${BLOCKLIST_FILE}" ]; then
                    local mac_list=$(grep -oE '"mac"[[:space:]]*:[[:space:]]*"[0-9A-Fa-f:]+"' "${BLOCKLIST_FILE}" 2>/dev/null | sed 's/.*"mac"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')
                    for mac in ${mac_list}; do
                        if [ -n "${mac}" ] && [ "${mac}" != "00:00:00:00:00:00" ] && [ "${mac}" != "FF:FF:FF:FF:FF:FF" ]; then
                            local lower_mac=$(echo "${mac}" | tr '[:upper:]' '[:lower:]')
                            iptables -I INPUT -m mac --mac-source "${lower_mac}" -j DROP 2>/dev/null
                            iptables -I FORWARD -m mac --mac-source "${lower_mac}" -j DROP 2>/dev/null
                        fi
                    done
                fi
                break
            fi
        done
        rm -f "${BLOCKLIST_BACKUP}" 2>/dev/null
    fi

    # 5. 执行首次流量采集（collect.lua 已废弃，跳过）
    # 流量统计由 router_assistant.lua 在用户访问页面时实时采集

    echo "traffic-stats: 流量数据清理完成（黑名单已保留）"
}

EXTRA_COMMANDS="purge_data status"
EXTRA_HELP="	purge_data	清理所有流量统计数据（保留黑名单配置）"
