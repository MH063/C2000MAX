{
        "luci-app-router-assistant": {
                "description": "RouterAssistant - Network Management",
                "read": {
                        "uci": [ "*" ],
                        "file": {
                                "/proc/net/arp": [ "read" ],
                                "/etc/hosts": [ "read" ],
                                "/etc/ethers": [ "read" ],
                                "/tmp/dhcp.leases": [ "read" ],
                                "/usr/share/router-assistant/version.json": [ "read" ],
                                "/usr/share/router-assistant/oui_database.json": [ "read" ]
                        },
                        "exec": {
                                "/usr/bin/iw": [ "exec" ],
                                "/usr/sbin/iptables": [ "exec" ],
                                "/usr/sbin/ip6tables": [ "exec" ],
                                "/usr/bin/ipset": [ "exec" ],
                                "/usr/bin/hostapd_cli": [ "exec" ],
                                "/usr/sbin/ebtables": [ "exec" ],
                                "/usr/bin/conntrack": [ "exec" ],
                                "/usr/bin/curl": [ "exec" ],
                                "/usr/bin/ip": [ "exec" ],
                                "/usr/bin/homebox": [ "exec" ],
                                "/usr/libexec/router_assistant/collect_traffic.lua": [ "exec" ]
                        }
                },
                "write": {
                        "uci": [ "*" ],
                        "file": {
                                "/etc/config/*": [ "write" ]
                        },
                        "exec": {
                                "/usr/sbin/iptables": [ "exec" ],
                                "/usr/sbin/ip6tables": [ "exec" ],
                                "/usr/bin/ipset": [ "exec" ],
                                "/usr/bin/conntrack": [ "exec" ],
                                "/etc/init.d/traffic-stats": [ "exec" ]
                        }
                }
        }
}
